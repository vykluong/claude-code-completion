# ---------------------------------------------------------------------------
# project (subcommands)
# ---------------------------------------------------------------------------
_claude_project() {
  local curcontext="$curcontext" state line
  _arguments -C \
    '1:project command:_claude_project_commands' \
    '*:: :->sub'
  case $state in
    sub)
      case $words[1] in
        purge) _claude_project_purge ;;
      esac
      ;;
  esac
}

_claude_project_commands() {
  local -a c
  c=(
    'purge:Delete all Claude Code state for a project'
    'help:Display help for command'
  )
  _describe -t project-commands 'project command' c
}

_claude_project_purge() {
  _arguments \
    '--all[Purge state for every project (mutually exclusive with a path)]' \
    '--dry-run[List what would be deleted without deleting anything]' \
    '(-i --interactive)'{-i,--interactive}'[Prompt for each item before deleting]' \
    '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1::path:_directories'
}

# ---------------------------------------------------------------------------
# daemon (hidden, hand-rolled parser; flat subcommand list)
# ---------------------------------------------------------------------------
_claude_daemon() {
  local curcontext="$curcontext" state line
  _arguments -C \
    '1:daemon command:_claude_daemon_commands' \
    '*:: :->sub'
  case $state in
    sub)
      case $words[1] in
        run)                   _claude_daemon_run ;;
        stop)                  _claude_daemon_stop ;;
        status|logs|uninstall) _claude_daemon_global ;;
      esac
      ;;
  esac
}

_claude_daemon_commands() {
  local -a c
  c=(
    'run:Run the supervisor in the foreground'
    'status:Show daemon pid, version, uptime'
    'logs:Tail the daemon log'
    'uninstall:Remove the background service'
    'stop:Shut down the supervisor and terminate background sessions'
  )
  _describe -t daemon-commands 'daemon command' c
}

_claude_daemon_global() {
  _arguments \
    '--json-path[Config file (default: ~/.claude/daemon.json)]:path:_files' \
    '--log-file[Log file (default: ~/.claude/daemon.log)]:path:_files' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_claude_daemon_run() {
  _arguments \
    '--json-path[Config file (default: ~/.claude/daemon.json)]:path:_files' \
    '--log-file[Log file (default: ~/.claude/daemon.log)]:path:_files' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    '1::json-path:_files'
}

_claude_daemon_stop() {
  _arguments \
    '--any[Also stop a transient (non-service) daemon]' \
    '--keep-workers[Leave detached sessions running]' \
    '--json-path[Config file (default: ~/.claude/daemon.json)]:path:_files' \
    '--log-file[Log file (default: ~/.claude/daemon.log)]:path:_files' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

# ---------------------------------------------------------------------------
# import-conversations (hidden; positional export path + options)
# ---------------------------------------------------------------------------
_claude_import_conversations() {
  _arguments \
    '--cwd[Archive directory the imported sessions anchor to]:dir:_directories' \
    '--dry-run[Parse and verify manifest without writing files]' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1:export path:_files'
}

# ---------------------------------------------------------------------------
# remote-control (hidden, hand-rolled parser; options only)
# NOTE: --permission-mode here offers 'default' (NOT 'manual'), differing from
# the top-level enum; --spawn has three modes.
# ---------------------------------------------------------------------------
_claude_remote_control() {
  _arguments \
    '--name[Name for the session (shown in claude.ai/code)]:name:' \
    '--remote-control-session-name-prefix[Prefix for auto-generated session names]:prefix:' \
    '(-c --continue)'{-c,--continue}'[Resume the last session in this directory]' \
    '--session-id[Resume a specific session by ID]:id:' \
    '--permission-mode[Permission mode for spawned sessions]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)' \
    '--debug-file[Write debug logs to file]:path:_files' \
    '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
    '--spawn[Spawn mode]:mode:(same-dir worktree session)' \
    '--capacity[Max concurrent sessions in worktree or same-dir mode]:N:' \
    '(--create-session-in-dir --no-create-session-in-dir)--create-session-in-dir[Pre-create a session in the current directory]' \
    '(--create-session-in-dir --no-create-session-in-dir)--no-create-session-in-dir[Do not pre-create a session in the current directory]' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_claude "$@"
