# ---------------------------------------------------------------------------
# plugin | plugins (subcommands, one nested level for marketplace/eval)
# ---------------------------------------------------------------------------
_claude_plugin() {
  local curcontext="$curcontext" state line
  _arguments -C \
    '1:plugin command:_claude_plugin_commands' \
    '*:: :->sub'
  case $state in
    sub)
      case $words[1] in
        details)          _claude_plugin_details ;;
        disable)          _claude_plugin_disable ;;
        enable)           _claude_plugin_enable ;;
        eval)             _claude_plugin_eval ;;
        init|new)         _claude_plugin_init ;;
        install|i)        _claude_plugin_install ;;
        list)             _claude_plugin_list ;;
        marketplace)      _claude_plugin_marketplace ;;
        prune|autoremove) _claude_plugin_prune ;;
        tag)              _claude_plugin_tag ;;
        uninstall|remove) _claude_plugin_uninstall ;;
        update)           _claude_plugin_update ;;
        validate)         _claude_plugin_validate ;;
      esac
      ;;
  esac
}

_claude_plugin_commands() {
  local -a c
  c=(
    'details:Show a plugin component inventory and projected token cost'
    'disable:Disable an enabled plugin'
    'enable:Enable a disabled plugin'
    'eval:Run eval cases against a plugin and report scored results'
    'init:Scaffold a new plugin'
    'new:Scaffold a new plugin (alias)'
    'install:Install a plugin from available marketplaces'
    'i:Install a plugin from available marketplaces (alias)'
    'list:List installed plugins'
    'marketplace:Manage Claude Code marketplaces'
    'prune:Remove auto-installed dependencies that are no longer needed'
    'autoremove:Remove auto-installed dependencies (alias)'
    'tag:Create a git tag for a plugin release'
    'uninstall:Uninstall an installed plugin'
    'remove:Uninstall an installed plugin (alias)'
    'update:Update a plugin to the latest version'
    'validate:Validate a plugin or marketplace manifest'
    'help:Display help for command'
  )
  _describe -t plugin-commands 'plugin command' c
}

