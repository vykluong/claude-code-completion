#compdef claude

# ZSH completion script for Claude Code CLI
# Target: Claude Code CLI 2.1.220
# Command/option tables generated against "claude --help" (and per-subcommand
# --help output) on 2.1.220, captured 2026-08-02.
#
# Policy: completions cover everything invokable, including commands and flags
# that "--help" hides. Hidden entries are marked and were confirmed by probing
# the installed binary, not read out of help text.

_claude() {
  local curcontext="$curcontext" state line context
  typeset -A opt_args

  # Global options available to the top-level command.
  # Repeatable options carry a leading '*'; enum values are inline; optional
  # values use '::'; brace pairs are written inline so they expand at array
  # construction time (never store a brace spec in a scalar).
  local global_options=(
    '*--add-dir[Additional directories to allow tool access to]:directory:_directories'
    '--agent[Agent for the current session]:agent:'
    '--agents[JSON object defining custom agents]:json:'
    '--allow-dangerously-skip-permissions[Enable bypassing all permission checks as an option]'
    '(--allowedTools --allowed-tools)'{--allowedTools,--allowed-tools}'[Comma or space-separated list of tool names to allow]:tools:'
    '--append-system-prompt[Append a system prompt to the default system prompt]:prompt:'
    # Hidden: absent from "claude --help", but parsed. Probed 2026-08-02 on
    # 2.1.220 -- rejects a missing path with "Append system prompt file not
    # found", where an unknown flag would instead be "unknown option".
    '--append-system-prompt-file[Append a system prompt from a file to the default system prompt]:path:_files'
    '--ax-screen-reader[Render screen-reader friendly output]'
    '(--bg --background)'{--bg,--background}'[Start the session as a background agent and return immediately]'
    '--bare[Minimal mode: skip hooks, LSP, plugin sync, attribution, and more]'
    '--betas[Beta headers to include in API requests (API key users only)]:betas:'
    '--brief[Enable SendUserMessage tool for agent-to-user communication]'
    '(--chrome --no-chrome)--chrome[Enable Claude in Chrome integration]'
    '(--chrome --no-chrome)--no-chrome[Disable Claude in Chrome integration]'
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation in the current directory]'
    '--dangerously-skip-permissions[Bypass all permission checks]'
    '(-d --debug)'{-d,--debug}'[Enable debug mode with optional category filtering]::filter:'
    '--debug-file[Write debug logs to a specific file path]:path:_files'
    '--disable-slash-commands[Disable all skills]'
    '(--disallowedTools --disallowed-tools)'{--disallowedTools,--disallowed-tools}'[Comma or space-separated list of tool names to deny]:tools:'
    '--effort[Effort level for the current session]:level:(low medium high xhigh max)'
    '--exclude-dynamic-system-prompt-sections[Move per-machine sections into the first user message]'
    '--fallback-model[Enable automatic fallback to specified model(s)]:model:'
    '--file[File resources to download at startup (file_id:relative_path)]:specs:'
    '--fork-session[When resuming, create a new session ID instead of reusing the original]'
    '--forward-subagent-text[Forward subagent text and thinking blocks as messages]'
    '--from-pr[Resume a session linked to a PR by number/URL, or open interactive picker]::pr:'
    '--ide[Automatically connect to IDE on startup if exactly one valid IDE is available]'
    '--include-hook-events[Include all hook lifecycle events in the output stream]'
    '--include-partial-messages[Include partial message chunks as they arrive]'
    '--input-format[Input format (only works with --print)]:format:(text stream-json)'
    '--json-schema[JSON Schema for structured output validation]:schema:'
    '--max-budget-usd[Maximum dollar amount to spend on API calls]:amount:'
    '*--mcp-config[Load MCP servers from JSON files or strings]:config:_files'
    # Aliases are the stable contract; the full names are best-effort and churn
    # with releases. Any other string is still accepted -- the CLI validates it.
    "--model[Model for the current session (alias or full name)]:model:(fable opus sonnet haiku claude-fable-5 claude-opus-5 claude-sonnet-5 claude-haiku-4-5-20251001)"
    '(-n --name)'{-n,--name}'[Set a display name for this session]:name:'
    '--no-session-persistence[Disable session persistence (only works with --print)]'
    '--output-format[Output format (only works with --print)]:format:(text json stream-json)'
    '--permission-mode[Permission mode to use for the session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '*--plugin-dir[Load a plugin from a directory or .zip for this session only]:path:_files -/'
    '*--plugin-url[Fetch a plugin .zip from a URL for this session only]:url:'
    '(-p --print)'{-p,--print}'[Print response and exit (useful for pipes)]'
    '--prompt-suggestions[Enable prompt suggestions]::value:(true false 1 0 yes no on off)'
    '--remote-control[Start an interactive session with Remote Control enabled]::name:'
    '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:'
    '--replay-user-messages[Re-emit user messages from stdin back on stdout for acknowledgment]'
    '(-r --resume)'{-r,--resume}'[Resume a conversation by session ID, or open interactive picker]::session id:'
    '--safe-mode[Start with all customizations disabled (troubleshooting)]'
    '--session-id[Use a specific session ID for the conversation (valid UUID)]:uuid:'
    '--setting-sources[Comma-separated list of setting sources to load]:sources:'
    '--settings[Path to a settings JSON file or a JSON string]:file or json:_files'
    '--strict-mcp-config[Only use MCP servers from --mcp-config]'
    '--system-prompt[System prompt to use for the session]:prompt:'
    # Hidden, same as --append-system-prompt-file above.
    '--system-prompt-file[Read the system prompt for the session from a file]:path:_files'
    '--tmux=-[Create a tmux session for the worktree (requires --worktree; =classic for traditional tmux)]::mode:(classic)'
    '--tools[Specify the list of available tools from the built-in set]:tools:'
    '--verbose[Override verbose mode setting from config]'
    '(-v --version)'{-v,--version}'[Output the version number]'
    '(-w --worktree)'{-w,--worktree}'[Create a new git worktree for this session]::name:'
    '(-h --help)'{-h,--help}'[Display help for command]'
  )

  # -A '-*' stops the outer _arguments from parsing global options once the
  # subcommand word has appeared, so a leaf option that shares a name with a
  # global (e.g. remote-control's --permission-mode) is handled by the leaf and
  # not shadowed by the global spec.
  _arguments -C -A '-*' \
    $global_options \
    '1: :_claude_commands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        mcp)                  _claude_mcp ;;
        agents)               _claude_agents ;;
        auth)                 _claude_auth ;;
        auto-mode)            _claude_auto_mode ;;
        doctor)               _claude_doctor ;;
        gateway)              _claude_gateway ;;
        install)              _claude_install ;;
        plugin|plugins)       _claude_plugin ;;
        project)              _claude_project ;;
        setup-token)          _claude_setup_token ;;
        ultrareview)          _claude_ultrareview ;;
        update|upgrade)       _claude_update ;;
        daemon)               _claude_daemon ;;
        import-conversations) _claude_import_conversations ;;
        remote-control)       _claude_remote_control ;;
        *)
          # Unknown/leaf command: fall through to a free-text prompt argument.
          ;;
      esac
      ;;
  esac
}

_claude_commands() {
  local -a commands hidden_commands
  commands=(
    'agents:Manage background agents'
    'auth:Manage authentication'
    'auto-mode:Inspect or reset auto mode classifier configuration'
    'doctor:Check the health of your Claude Code installation'
    'gateway:Run the enterprise auth/telemetry gateway'
    'install:Install Claude Code native build'
    'mcp:Configure and manage MCP servers'
    'plugin:Manage Claude Code plugins'
    'plugins:Manage Claude Code plugins (alias)'
    'project:Manage Claude Code project state'
    'setup-token:Set up a long-lived authentication token'
    'ultrareview:Run a cloud-hosted multi-agent code review'
    'update:Check for updates and install if available'
    'upgrade:Check for updates and install if available (alias)'
  )
  hidden_commands=(
    'daemon:Manage the background session supervisor'
    'import-conversations:Import conversations from an export'
    'remote-control:Control local sessions from claude.ai or mobile'
  )
  _describe -t commands 'claude commands' commands
  _describe -t hidden-commands 'hidden commands' hidden_commands
}

_claude_mcp() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '1:mcp command:_claude_mcp_commands' \
    '*:: :->sub'

  case $state in
    sub)
      case $words[1] in
        add)                     _claude_mcp_add ;;
        add-from-claude-desktop) _claude_mcp_add_from_claude_desktop ;;
        add-json)                _claude_mcp_add_json ;;
        get)                     _claude_mcp_get ;;
        login)                   _claude_mcp_login ;;
        logout)                  _claude_mcp_logout ;;
        remove)                  _claude_mcp_remove ;;
        serve)                   _claude_mcp_serve ;;
        list|reset-project-choices|help)
          # Leaf commands with no further arguments to complete.
          ;;
      esac
      ;;
  esac
}

_claude_mcp_commands() {
  local -a mcp_commands
  mcp_commands=(
    'add:Add an MCP server to Claude Code'
    'add-from-claude-desktop:Import MCP servers from Claude Desktop (Mac and WSL only)'
    'add-json:Add an MCP server (stdio or SSE) with a JSON string'
    'get:Get details about an MCP server'
    'help:Display help for a command'
    'list:List configured MCP servers'
    'login:Authenticate with an MCP server (HTTP, SSE, or claude.ai connector)'
    'logout:Clear stored OAuth credentials for an MCP server'
    'remove:Remove an MCP server'
    'reset-project-choices:Reset approved and rejected project-scoped servers'
    'serve:Start the Claude Code MCP server'
  )
  _describe -t mcp-commands 'mcp command' mcp_commands
}

_claude_mcp_add() {
  _arguments \
    '(-t --transport)'{-t,--transport}'[Transport type]:transport:(stdio sse http)' \
    '(-s --scope)'{-s,--scope}'[Configuration scope]:scope:(local user project)' \
    '*'{-e,--env}'[Set environment variable]:KEY=value:' \
    '*'{-H,--header}'[Set WebSocket header]:header:' \
    '--client-id[OAuth client ID for HTTP/SSE servers]:client id:' \
    '--client-secret[Prompt for OAuth client secret]' \
    '--callback-port[Fixed port for OAuth callback]:port:' \
    '1:server name:' \
    '2:command or URL:' \
    '*:server arguments:'
}

_claude_mcp_add_from_claude_desktop() {
